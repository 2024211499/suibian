# 复制为 .env 后填写；.env 不进仓库。模型 ID 和价格以两家控制台为准（技术文档 0.3）。
MOCK=0

# 大模型：主用通义千问（百炼），备用 DeepSeek
QWEN_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_KEY=
QWEN_MAIN=qwen-plus
QWEN_LITE=qwen-flash
DS_BASE=https://api.deepseek.com
DS_KEY=
DS_MAIN=

# 高德 Web 服务 Key（只放服务器；Android SDK Key 在手机端配置，两者分开申请）
AMAP_WEB_KEY=

# 和风天气（控制台分配的 API Host + JWT 三件套）
QW_HOST=
QW_PROJECT_ID=
QW_KEY_ID=
QW_PRIVATE_KEY=

# Redis（compose 内网地址；本地开发用 redis://localhost:6379/0）
REDIS_URL=redis://redis:6379/0

# 预算上限（技术文档 6.4 / 两人方案第七节：高德搜索 5000 次/月）
DAILY_LLM_CALLS_MAX=3000
DAILY_SEARCH_MAX=120
DAILY_GENERATE_MAX=10

# 域名（Caddy 自动申请 HTTPS 证书用）
DOMAIN=example.com
